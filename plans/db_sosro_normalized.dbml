// db_sosro - DBML (SETELAH normalisasi sesuai plan)
// Base: db_sosro.sql + normalisasi-keluarga-pilot.md + normalisasi-struktur-database-prioritas.md
//
// Catatan keputusan yang dibuat di luar yang eksplisit tertulis di 2 MD di atas (perlu dikoreksi kalau tidak setuju):
// 1. admins.cabang diikutkan jadi FK ke cabangs (MD asli cuma nyebut lowongan.penempatan_cabang)
// 2. pendidikan_formal + pendidikan_informal digabung jadi 1 tabel applicant_educations dengan union
//    semua field (field yang tidak relevan ke satu tipe jadi nullable) -- field shape dua tipe ini beda
//    (formal: jenjang/sekolah/jurusan/nilai/tahun_masuk/tahun_lulus/is_current_edu, informal: tahun/kursus/penyelenggara),
//    beda dari kasus keluarga inti/kandung yang field-nya identik persis. Worth dipikir ulang apakah
//    lebih baik 2 tabel terpisah daripada 1 tabel dengan banyak kolom nullable.
//
// KOREKSI: applicant_job_field_interests awalnya didesain tanpa kolom `rank` (dikira cuma himpunan
// minat biasa). Ternyata UI aslinya drag-to-rank (SortableJS) atas SEMUA 13 job_fields sekaligus
// (ProfileController.php validasi 'minat_ordered' => 'required|array|min:13', urutan array = ranking).
// Sudah ditambah kolom `rank` -- tiap pelamar akan selalu punya persis 13 baris di tabel ini.
//
// 2 tambahan lain yang kelewat dari daftar di atas (ketemu belakangan, sama-sama tidak dibahas di
// 2 MD manapun -- perlu dicek data lama dulu sebelum dieksekusi, migration bisa gagal kalau data
// existing melanggar constraint baru ini):
// 4. applicant_profiles.nik -- ditambah `unique`. Migration asli (2025_12_29_071417) nik-nya nullable
//    tanpa constraint apa pun. Cek dulu ada tidaknya NIK kosong/duplikat di data sekarang sebelum
//    nambah constraint ini.
// 5. lowongan.created_by / updated_by -- ditambah FK constraint ke admins.id. Migration asli
//    (2025_12_07_123629) cuma unsignedBigInteger biasa, tidak ada ->constrained(). Cek dulu ada
//    tidaknya baris lowongan yang created_by/updated_by-nya nunjuk ke admin yang sudah terhapus
//    (data yatim) sebelum nambah FK constraint ini.
//
// 2 koreksi lagi hasil riset lanjutan (grep ke semua blade view + controller yang benar-benar jalan):
// 6. cabangs.kelompok -- enum ditambah jadi 4 nilai (HO, KPW, Pabrik, Lainnya), bukan 3 (KPW, Pabrik,
//    Lainnya) seperti draft awal. Kantor Pusat dipisah jadi grup HO sendiri supaya konsisten sama
//    office_type (HO/KPW/KPB) yang sudah dipakai di admin/applicants/index.blade.php dan
//    app/Mail/AcceptedEmail.php buat milih template email offering.
// 7. applications.status -- nilai aktual yang benar-benar dipakai kode jauh lebih banyak dari enum lama
//    (submitted/review/accepted/rejected): pending, psikotes, interview, offering, mcu, accepted,
//    rejected. Kolom tetap varchar (bukan enum DB) karena state machine-nya masih bisa nambah tahap baru.
//
// 8. job_categories & job_types DIBATALKAN jadi tabel master -- dikembalikan jadi varchar biasa di
//    lowongan (kategori, tipe_lowongan). Alasan: cuma 3-4 nilai, fixed vocabulary, sangat kecil
//    kemungkinan berubah, dan cuma dipakai 1 tempat (lowongan) -- tidak sepadan biaya JOIN-nya.
//    job_fields TETAP jadi tabel (beda kasus -- dipakai bareng 2 entitas: lowongan.bidang_id DAN
//    applicant_job_field_interests, jadi tetap butuh direlasikan meski isinya sama-sama statis).
//    cabangs TETAP jadi tabel juga -- datanya lebih mungkin berubah (buka/tutup cabang) dan sudah
//    ada bukti nyata bug dari duplikasi string (Kebun vs Perkebunan) di skema lama.

Table admins {
  id bigint [pk, increment]
  name varchar
  email varchar [unique]
  role varchar [default: 'admin']
  cabang_id bigint [ref: > cabangs.id, note: 'ganti dari cabang varchar bebas']
  photo varchar
  password varchar
  remember_token varchar
  created_at timestamp
  updated_at timestamp
}

Table applicants {
  id bigint [pk, increment]
  status varchar [default: 'Pending']
  created_at timestamp
  updated_at timestamp
  user_id bigint [unique, ref: > users.id, note: 'ditambah unique -- relasi User::applicant() hasOne, tapi migration asli tidak pernah kasih unique constraint']
  profile_completed boolean [default: 0]
  biodata_progress int [default: 0]
  consent_accepted boolean [default: 0]
  personal_completed boolean [default: 0]
  family_completed boolean [default: 0]
  education_completed boolean [default: 0]
  experience_completed boolean [default: 0]
  documents_completed boolean [default: 0]
  biodata_submitted boolean [default: 0]
}

Table applicant_documents {
  id bigint [pk, increment]
  applicant_id bigint [ref: > applicants.id]
  type varchar [note: 'foto, cv, ktp, ijazah, sim, npwp, bpjs_kes, bpjs_tk, lain']
  file_path varchar
  is_required boolean [default: 0]
  extracted_data json
  created_at timestamp
  updated_at timestamp
}

Table applicant_profiles {
  id bigint [pk, increment]
  applicant_id bigint [unique, ref: > applicants.id, note: 'ditambah unique -- relasi Applicant::profile() hasOne, tapi migration asli tidak pernah kasih unique constraint']
  nik varchar [unique, note: 'ditambah unique constraint']
  jk varchar [note: 'enum: L,P']
  tempat_lahir varchar
  tanggal_lahir date
  tinggi_badan varchar
  berat_badan varchar
  alamat text
  domisili text
  phone varchar
  agama varchar
  status_nikah varchar
  jenis_sim json [note: 'tetap JSON, tidak dinormalisasi (opsional/low priority)']
  instagram varchar
  linkedin varchar
  created_at timestamp
  updated_at timestamp
  ex_employee varchar
  ex_company_name varchar
  ex_last_position varchar
  penyakit text
  perokok varchar [note: 'enum: ya,tidak']
  bertato varchar [note: 'enum: ya,tidak']
  expected_salary varchar
  expected_facilities text
  ready_dinas varchar [default: 'Ya']
  ready_placed_out varchar [default: 'Ya']
  company_reference varchar

  // DIHAPUS: data_keluarga, pendidikan_formal, pendidikan_informal, pengalaman_kerja,
  //          minat, doc_foto..doc_lain (9 kolom), pendidikan_terakhir, jurusan, ipk, nama_lengkap
  //          (nama_lengkap dead column -- tidak pernah masuk whitelist $request->only([...]) di
  //          ProfileController, jadi tidak pernah tertulis. users.name jadi satu-satunya sumber nama.)
}

// ================= TABEL ANAK BARU (pengganti kolom JSON) =================

Table applicant_family_members {
  id bigint [pk, increment]
  applicant_profile_id bigint [ref: > applicant_profiles.id]
  tipe varchar [note: 'enum: inti, kandung']
  nama varchar
  hubungan varchar
  pendidikan varchar
  tempat_lahir varchar
  tgl_lahir date
  pekerjaan varchar
  hp varchar
  created_at timestamp
  updated_at timestamp
}

Table applicant_educations {
  id bigint [pk, increment]
  applicant_profile_id bigint [ref: > applicant_profiles.id]
  tipe varchar [note: 'enum: formal, informal']
  jenjang varchar [note: 'formal only']
  sekolah varchar [note: 'formal only']
  jurusan varchar [note: 'formal only']
  nilai varchar [note: 'formal only']
  tahun_masuk int [note: 'formal only']
  tahun_lulus int [note: 'formal only']
  is_current_edu boolean [note: 'formal only']
  kursus varchar [note: 'informal only']
  penyelenggara varchar [note: 'informal only']
  tahun int [note: 'informal only']
  created_at timestamp
  updated_at timestamp
}

Table applicant_work_experiences {
  id bigint [pk, increment]
  applicant_profile_id bigint [ref: > applicant_profiles.id]
  perusahaan varchar
  jabatan varchar
  divisi varchar
  gaji varchar
  fasilitas varchar
  masih_bekerja boolean
  tanggal_masuk date
  tanggal_keluar date
  alasan text
  kontak_referensi varchar
  created_at timestamp
  updated_at timestamp
}

Table applicant_job_field_interests {
  applicant_profile_id bigint [ref: > applicant_profiles.id]
  job_field_id bigint [ref: > job_fields.id]
  rank int [note: '1 = paling diminati, 13 = paling kurang diminati - dari urutan drag SortableJS di form. Setiap pelamar selalu punya persis 13 baris (semua bidang wajib diranking, bukan dipilih sebagian)']

  indexes {
    (applicant_profile_id, job_field_id) [pk]
  }
}

// ================= TABEL MASTER BARU (pengganti string bebas) =================

Table cabangs {
  id bigint [pk, increment]
  nama varchar [unique, note: 'KPW Jakarta Banten, Pabrik Cakung, Kantor Pusat, dst']
  kelompok varchar [note: 'enum: HO, KPW, Pabrik, Lainnya -- HO khusus Kantor Pusat, dipisah dari Lainnya (Kebun, Poci Kreasi Mandiri) supaya cocok sama office_type (HO/KPW/KPB) yang dipakai app/Mail/AcceptedEmail.php']
  created_at timestamp
  updated_at timestamp
}

Table job_fields {
  id bigint [pk, increment]
  nama varchar [unique, note: 'Marketing, Finance & Accounting, dst - dipakai bareng lowongan.bidang & applicant minat']
}

// ================= applications, lowongan (kolom quasi-lookup diganti FK) =================

Table applications {
  id bigint [pk, increment]
  applicant_id bigint [ref: > applicants.id]
  lowongan_id bigint [ref: > lowongan.id]
  status varchar [note: 'nilai aktual: pending, psikotes, interview, offering, mcu, accepted, rejected -- state machine pipeline rekrutmen, bukan cuma 4 nilai flat']
  notes text
  created_at timestamp
  updated_at timestamp

  indexes {
    (applicant_id, lowongan_id) [unique]
  }
}

Table lowongan {
  id bigint [pk, increment]
  kode_lowongan varchar [unique]
  judul_lowongan varchar
  kategori varchar [note: 'tetap string bebas, tidak dinormalisasi -- cuma 3 nilai (Profesional, Management Trainee, Magang), sangat kecil kemungkinan berubah, tidak worth jadi tabel']
  bidang_id bigint [ref: > job_fields.id, note: 'ganti dari bidang varchar']
  tipe_lowongan varchar [note: 'tetap string bebas, tidak dinormalisasi -- cuma 4 nilai (Full-time, Part-time, Freelance, Kontrak), fixed vocabulary, tidak worth jadi tabel']
  cabang_id bigint [ref: > cabangs.id, note: 'ganti dari penempatan_cabang varchar']
  lokasi_kerja varchar
  jobdesk text
  kualifikasi text
  tanggal_mulai date
  tanggal_akhir date
  status_lowongan varchar [default: 'aktif', note: 'enum: aktif,tidak aktif,dihapus,selesai']
  created_by bigint [ref: > admins.id, note: 'ditambah FK constraint yang sebelumnya tidak ada']
  updated_by bigint [ref: > admins.id]
  created_at timestamp
  updated_at timestamp
}

// ================= tidak berubah =================

Table cache {
  key varchar [pk]
  value text
  expiration int
}

Table cache_locks {
  key varchar [pk]
  owner varchar
  expiration int
}

Table contacts {
  id bigint [pk, increment]
  name varchar
  email varchar
  city varchar
  message text
  status varchar [default: 'pending', note: 'enum: pending,forwarded,replied']
  admin_id bigint [ref: > admins.id]
  created_at timestamp
  updated_at timestamp
}

Table failed_jobs {
  id bigint [pk, increment]
  uuid varchar [unique]
  connection text
  queue text
  payload text
  exception text
  failed_at timestamp
}

Table jobs {
  id bigint [pk, increment]
  queue varchar
  payload text
  attempts int
  reserved_at int
  available_at int
  created_at int
}

Table job_batches {
  id varchar [pk]
  name varchar
  total_jobs int
  pending_jobs int
  failed_jobs int
  failed_job_ids text
  options text
  cancelled_at int
  created_at int
  finished_at int
}

Table migrations {
  id int [pk, increment]
  migration varchar
  batch int
}

Table password_reset_tokens {
  email varchar [pk]
  token varchar
  created_at timestamp
}

Table sessions {
  id varchar [pk]
  user_id bigint
  ip_address varchar
  user_agent text
  payload text
  last_activity int

  indexes {
    user_id
    last_activity
  }
}

Table users {
  id bigint [pk, increment]
  name varchar
  email varchar [unique]
  role varchar [default: 'user']
  email_verified_at timestamp
  password varchar
  remember_token varchar
  created_at timestamp
  updated_at timestamp
  photo varchar
}
